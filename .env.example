# FastAPI Blog Admin Configuration

# Admin credentials (set unique values before enabling the admin panel)
FASTAPI_BLOG_ADMIN_LOGIN=admin
FASTAPI_BLOG_ADMIN_PASSWORD=

# Session secret key (required; generate a unique random value of 32+ chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database URL
# SQLite (default): sqlite+aiosqlite:///./data/app.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Debug mode (optional, default: false)
DEBUG=false

# Include REST API for programmatic access (optional, default: false)
FASTAPI_BLOG_INCLUDE_API=false
